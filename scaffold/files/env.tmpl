# Local development configuration for [[.SiteName]]. Loaded by godotenv at
# startup; variables already set in the real environment always win.
#
# This file is gitignored. Deployments should use their platform's config
# rather than shipping it.

# The initial admin account, created on the first startup only — after
# that this password is not consulted again, so change it in the admin
# area rather than here. Generated for this project alone; nothing about
# it is shared with any other site built from the same template.
#
# Deployments set CMS_ADMIN_PASSWORD in their platform's config instead.
# Without it no initial account is created, which is deliberate: a
# password compiled into the template would be a published credential.
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=[[.AdminPassword]]

# Where the server listens.
ADDR=:4000

# The site's canonical public address. Unset is fine on this machine —
# links fall back to the address the request came in on. Set it before
# deploying: a password-reset link is read by somebody other than whoever
# asked for it, so the CMS will not build one out of a request's Host
# header, and a public deployment without this sends no reset emails.
# CMS_SITE_URL=https://example.com

# If a proxy or load balancer sits in front of the app, name the header it
# sets to the real client address, or the login throttle sees every visitor
# as one. Only set this when the proxy overwrites the header — if a client
# can send it, they get a fresh throttle allowance per request.
# CMS_CLIENT_IP_HEADER=X-Forwarded-For

# Forces the session cookie's Secure flag on. Usually unnecessary: an
# https:// CMS_SITE_URL above already implies it. This is for HTTPS in
# front of a site that leaves CMS_SITE_URL unset.
# CMS_SECURE_COOKIES=true

# Overrides the DSN compiled into main.go. Matches docker-compose.yml.
# DATABASE_URL=[[.DSN]]

# --- Media library (optional) ---------------------------------------
# Image uploads go to any S3-compatible object store. Without S3_ENDPOINT
# the media library is simply disabled and the rest of the CMS works.
# S3_ENDPOINT=us-east-1.linodeobjects.com
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=
# S3_SECRET=
# Prefixes every key, so several sites can share one bucket.
# S3_KEY_PREFIX=[[.Slug]]
# Needed for MinIO and some self-hosted stores.
# S3_USE_PATH_STYLE=false
#
# By default media is proxied through the app, which works with a private
# bucket and needs no bucket policy. To serve straight from the bucket or a
# CDN instead, set one of these — and, for a bucket that was not created
# public, S3_APPLY_PUBLIC_POLICY once to open it. The policy on its own is
# refused at startup: it would open the bucket and nothing would read it.
# S3_PUBLIC_READ=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_APPLY_PUBLIC_POLICY=true

# --- Login CAPTCHA (optional) ---------------------------------------
# Self-hosted proof-of-work CAPTCHA (https://capjs.js.org) on the admin
# login form. Without CAP_URL the login page has no CAPTCHA.
[[if .Captcha]]# Open http://localhost:3300, log in with the ADMIN_KEY from
# docker-compose.yml, create a site key, then fill these in.
# CAP_URL=http://localhost:3300
# CAP_SITE_KEY=
# CAP_SECRET=
[[else]]# Add the cap and valkey services to docker-compose.yml first — see the
# example in the cms module.
# CAP_URL=http://localhost:3300
# CAP_SITE_KEY=
# CAP_SECRET=
[[end]]
# --- Tuning (optional) ----------------------------------------------
[[if .Tailwind]]# Content-driven Tailwind rebuilds: classes typed into CMS content get
# compiled CSS without a redeploy. See tailwind-content.sh.
CMS_TAILWIND_COMMAND=./tailwind-content.sh {content} {output}

[[end]]# Posts per page in the paginated blog and news listings. Defaults to 10.
# CMS_POSTS_PER_PAGE=10
# Rows per page in the admin's lists. Defaults to 25.
# CMS_ADMIN_PER_PAGE=25
