{{template "base" .}}

{{define "content"}}
{{/* The banner above the article is a sections region of its own, so it
     is built and styled on the page with the section gear — background
     image and where to anchor it, content width, corners, height. Empty
     on a post that has none, and the editor offers "Add a section" here
     the same as anywhere else. */}}
{{cmsSections "header"}}

<article>
    {{/* The banner carries the title as the page's <h1> when there is
         one, so the title here steps down to <h2> rather than competing
         with it. A post with no banner keeps the <h1> here — the page
         must have one either way. */}}
    <header class="mx-auto max-w-3xl px-6 pt-12">
        {{if cmsHasSections "header"}}
        <h2 class="text-4xl font-extrabold tracking-tight text-slate-900">{{.Title}}</h2>
        {{else}}
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">{{.Title}}</h1>
        {{end}}
        {{with .Post}}
        <p class="mt-3 text-sm text-slate-500">
            {{.PublishedAt.Format "January 2, 2006"}}{{with .Author}} · {{.}}{{end}}
        </p>
        {{end}}
    </header>

    {{cmsSections "sections"}}
</article>
{{end}}
