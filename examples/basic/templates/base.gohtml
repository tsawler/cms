{{define "base"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}} — Example Site</title>
    <link rel="stylesheet" href="/static/site.css">
    {{cmsHead}}
</head>
<body class="bg-white text-slate-800 antialiased">
<header class="border-b border-slate-200">
    <div class="mx-auto max-w-4xl px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-lg font-bold tracking-tight">Example&nbsp;Site</a>
        {{cmsNav "main"}}
        <style>
            /* Style the CMS-rendered nav via its stable classes. */
            .cms-nav{font-size:.875rem;color:#475569}
            @media (min-width:769px){.cms-nav-list{gap:1.5rem}}
            .cms-nav-link{text-decoration:none;color:inherit}
            .cms-nav-link:hover{color:#0f172a}
            .cms-nav-link.cms-active{color:#0f172a;font-weight:600}
            .cms-nav-sub .cms-nav-link:hover{background:#f1f5f9}
        </style>
    </div>
</header>

<main>{{block "content" .}}{{end}}</main>

<footer class="border-t border-slate-200 mt-16">
    <div class="mx-auto max-w-4xl px-6 py-8 text-sm text-slate-500">
        Built with the cms module.
    </div>
</footer>
{{cmsScripts}}
</body>
</html>{{end}}
