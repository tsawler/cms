{{define "title"}}{{.T "Log in"}} — CMS{{end}}

{{define "content"}}
{{if .Captcha}}
{{/* Must load before the widget. Redirects its two CDN dependencies at
     copies the CSP admits, and hands it the nonce to stamp on the inline
     script it runs inside its instrumentation frame — without which that
     script is blocked and the solver never finishes. Carried inline (under
     the same nonce) so the values match this response's policy. */}}
<script nonce="{{.Captcha.Nonce}}">
window.CAP_CUSTOM_WASM_URL = {{.Captcha.WasmURL}};
window.CAP_PAKO_URL = {{.Captcha.PakoURL}};
window.CAP_SCRIPT_NONCE = {{.Captcha.Nonce}};
</script>
<script type="module" src="{{.Captcha.ScriptURL}}"></script>
{{if not .Captcha.Visible}}
{{/* Invisible mode: solve the challenge in the background and fill the
     hidden cap-token field — no widget is shown. */}}
<script defer src="{{.AdminPath}}/static/login-captcha.js"></script>
{{end}}
{{end}}
<div class="cms-login-card">
    <h1>{{.T "Log in"}}</h1>
    {{with .Error}}<div class="cms-alert">{{.}}</div>{{end}}
    <form method="post" action="{{.AdminPath}}/login" novalidate{{if and .Captcha (not .Captcha.Visible)}} data-cap-endpoint="{{.Captcha.Endpoint}}"{{end}}>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="cms-field">
            <label for="email">{{.T "Email"}}</label>
            <input type="email" id="email" name="email" autocomplete="username" required autofocus>
        </div>
        <div class="cms-field">
            <label for="password">{{.T "Password"}}</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>
        {{/* Honeypot: hidden from people, filled in by bots. */}}
        <div class="cms-hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>
        <div class="cms-field cms-remember">
            <label>
                <input type="checkbox" name="remember" value="1">
                {{.T "Remember me"}}{{if gt .RememberDays 0}} {{.T "for"}} {{.RememberDays}} {{.T "days"}}{{else if gt .RememberHours 0}} {{.T "for"}} {{.RememberHours}} {{.T "hours"}}{{end}}
            </label>
        </div>
        {{with .Captcha}}
        {{if .Visible}}
        <div class="cms-field">
            <cap-widget data-cap-api-endpoint="{{.Endpoint}}"></cap-widget>
        </div>
        {{else}}
        <input type="hidden" name="cap-token" value="">
        {{end}}
        {{end}}
        <button type="submit" class="cms-btn cms-btn-primary cms-btn-block">{{.T "Log in"}}</button>
    </form>
    {{/* Only when the host wired a Mailer: a link to a form that could
         never send its email would look broken rather than be off. */}}
    {{if .ForgotEnabled}}
    <p class="cms-hint cms-login-alt"><a href="{{.AdminPath}}/forgot-password">{{.T "Forgot your password?"}}</a></p>
    {{end}}
</div>
{{end}}
