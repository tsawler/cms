{{define "title"}}{{.T "Log in"}} — CMS{{end}}

{{define "content"}}
{{if .Captcha}}
{{/* Must load before the widget: points the WASM solver at our own Cap
     server instead of a CDN the CSP blocks. */}}
<script src="{{.AdminPath}}/captcha.js"></script>
<script type="module" src="{{.Captcha.ScriptURL}}"></script>
{{if not .Captcha.Visible}}
{{/* Invisible mode: solve the challenge in the background and fill the
     hidden cap-token field — no widget is shown. */}}
<script defer src="{{.AdminPath}}/static/login-captcha.js"></script>
{{end}}
{{end}}
<div class="cms-login-card">
    <h1>{{.T "Log in"}}</h1>
    {{with .Error}}<div class="cms-alert">{{.}}</div>{{end}}
    <form method="post" action="{{.AdminPath}}/login" novalidate{{if and .Captcha (not .Captcha.Visible)}} data-cap-endpoint="{{.Captcha.Endpoint}}"{{end}}>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="cms-field">
            <label for="email">{{.T "Email"}}</label>
            <input type="email" id="email" name="email" autocomplete="username" required autofocus>
        </div>
        <div class="cms-field">
            <label for="password">{{.T "Password"}}</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>
        {{/* Honeypot: hidden from people, filled in by bots. */}}
        <div class="cms-hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>
        <div class="cms-field cms-remember">
            <label>
                <input type="checkbox" name="remember" value="1">
                {{.T "Remember me"}}{{if gt .RememberHours 0}} {{.T "for"}} {{.RememberHours}} {{.T "hours"}}{{end}}
            </label>
        </div>
        {{with .Captcha}}
        {{if .Visible}}
        <div class="cms-field">
            <cap-widget data-cap-api-endpoint="{{.Endpoint}}"></cap-widget>
        </div>
        {{else}}
        <input type="hidden" name="cap-token" value="">
        {{end}}
        {{end}}
        <button type="submit" class="cms-btn cms-btn-primary cms-btn-block">{{.T "Log in"}}</button>
    </form>
</div>
{{end}}
