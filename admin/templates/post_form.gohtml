{{define "title"}}{{if .IsNew}}{{.T "New post"}}{{else}}{{.T "Edit post"}}{{end}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{if .IsNew}}{{.T "New post"}}{{else}}{{.T "Edit post"}}{{end}}</h1>
    <div class="cms-actions">
        {{if not .IsNew}}
        <a class="cms-btn cms-btn-ghost" href="{{.AdminPath}}/posts/{{.FormPost.PostID}}/preview{{if not .IsDefaultLocale}}?locale={{.EditLocale}}{{end}}" target="_blank" rel="noopener">{{.T "Preview draft"}}</a>
        {{end}}
        <a class="cms-btn cms-btn-ghost" href="{{.AdminPath}}/posts">{{.T "Back to posts"}}</a>
    </div>
</div>

{{if and (not .IsNew) (gt (len .Locales) 1)}}
<p class="cms-tabs cms-locale-tabs">
    {{$def := index .Locales 0}}
    {{range .Locales}}
    <a {{if eq . $.EditLocale}}class="cms-active"{{end}} href="{{$.AdminPath}}/posts/{{$.FormPost.PostID}}{{if ne . $def}}?locale={{.}}{{end}}">{{.}}</a>
    {{end}}
</p>
{{if not .IsDefaultLocale}}<p class="cms-hint">{{.T "Editing translation:"}} <strong>{{.EditLocale}}</strong>.
{{.T "Fields left matching the default language keep showing it until you change them."}}
{{.T "Feed, address, date, and images live on the default-language tab."}}</p>{{end}}
{{end}}

<form class="cms-form cms-form-wide" method="post"
      action="{{if .IsNew}}{{.AdminPath}}/posts/new{{else}}{{.AdminPath}}/posts/{{.FormPost.PostID}}{{end}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input type="hidden" name="locale" value="{{.EditLocale}}">

    <div class="cms-field">
        <label for="title">{{.T "Title"}}</label>
        <input type="text" id="title" name="title" value="{{.FormPost.Title}}" required {{if .IsNew}}data-slug-source{{end}}>
        {{with index .FormErrors "title"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    {{if .IsDefaultLocale}}
    <div class="cms-field">
        <label for="feed">{{.T "Feed"}}</label>
        <select id="feed" name="feed">
            {{if or (.Can "blogs") (eq .FormPost.Feed "blog")}}
            <option value="blog" {{if eq .FormPost.Feed "blog"}}selected{{end}}>{{.T "Blog"}}</option>
            {{end}}
            {{if or (.Can "news") (eq .FormPost.Feed "news")}}
            <option value="news" {{if eq .FormPost.Feed "news"}}selected{{end}}>{{.T "News"}}</option>
            {{end}}
        </select>
        {{with index .FormErrors "feed"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="slug">{{.T "Address"}} <span class="cms-muted">{{.T "(after /blog/ or /news/; leave empty to use the title)"}}</span></label>
        <input type="text" id="slug" name="slug" value="{{.PostSlugTail}}" placeholder="{{.T "my-first-post"}}" {{if .IsNew}}data-slug-target{{end}}>
        {{with index .FormErrors "slug"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>
    {{end}}

    <div class="cms-field">
        <label for="description">{{.T "Summary"}} <span class="cms-muted">{{.T "(shown on listing cards and in the RSS feed)"}}</span></label>
        <input type="text" id="description" name="description" value="{{.FormPost.Description}}">
    </div>

    <div class="cms-field">
        <label for="meta_description">{{.T "Meta description"}} <span class="cms-muted">{{.T "(for search engines)"}}</span></label>
        <input type="text" id="meta_description" name="meta_description" value="{{.FormPost.MetaDescription}}">
        <p class="cms-hint">{{.T "Leave empty to use the summary. Search results usually cut off around 160 characters."}}</p>
    </div>

    {{if .IsDefaultLocale}}
    <div class="cms-field">
        <label for="published_at">{{.T "Date"}}</label>
        <input type="datetime-local" id="published_at" name="published_at"
               value="{{.FormPost.PublishedAt.Format "2006-01-02T15:04"}}">
        {{with index .FormErrors "published_at"}}<p class="cms-field-error">{{.}}</p>{{end}}
        <p class="cms-hint">{{.T "The date shown on the post and used to order listings — newest first."}}</p>
    </div>

    {{/* The byline is a display choice, not a change of author: the post
         stays recorded against whoever wrote it either way, so a new post
         offers the switch before there is a name to show. */}}
    <div class="cms-field cms-field-check">
        <label>
            <input type="checkbox" name="show_author" {{if not .FormPost.HideAuthor}}checked{{end}}>
            {{.T "Show the author's name"}}{{if not .IsNew}}{{with .FormPost.AuthorName}} <span class="cms-muted">({{.}})</span>{{end}}{{end}}
        </label>
        <p class="cms-hint">{{.T "Off publishes the post under the site's name, with the date but no byline."}}</p>
    </div>

    {{if .MediaEnabled}}
    {{/* The picker stores the library id, not one image address: the site
         then picks the size the slot needs when it renders the listing. An
         image that came from somewhere else has no id, so it keeps its
         address through the "keep" option and the hidden field beside it.

         There is no header picker: the banner at the top of a post is a
         section. Creating a post with an image seeds that section with it;
         after that the banner is edited on the post's own page, where its
         image, height, width, and everything else can be changed. */}}
    <div class="cms-field">
        <label for="thumbnail_media_id">{{.T "Thumbnail"}} <span class="cms-muted">{{.T "(optional — shown on listing cards)"}}</span></label>
        {{with .FormPostThumb}}<img src="{{.}}" alt="" class="cms-image-current">{{end}}
        <select id="thumbnail_media_id" name="thumbnail_media_id">
            <option value="">{{.T "— no thumbnail —"}}</option>
            {{$current := .FormPost.ThumbnailMediaIDValue}}
            {{if and (not $current) .FormPost.ThumbnailURL}}
            <option value="keep" selected>{{.T "(current image)"}}</option>
            {{end}}
            {{range .Media}}
            <option value="{{.ID}}" {{if eq .ID $current}}selected{{end}}>{{.Filename}} ({{.Width}}×{{.Height}})</option>
            {{end}}
        </select>
        <input type="hidden" name="thumbnail_url" value="{{.FormPost.ThumbnailURL}}">
        {{if .IsNew}}
        <p class="cms-hint">{{.T "This image also starts the banner at the top of the post — open the post on the site to restyle or remove it."}}</p>
        {{end}}
        <p class="cms-hint">{{.T "Choose from the"}} <a href="{{.AdminPath}}/media">{{.T "media library"}}</a>{{.T "; upload new images there first."}}</p>
    </div>
    {{end}}
    {{end}}

    {{template "form_regions" .}}

    {{if and .IsAdmin (not .IsNew) .IsDefaultLocale}}
    <details class="cms-advanced">
        <summary>{{.T "Advanced: post-specific CSS and JavaScript"}}</summary>
        <div class="cms-field">
            <label for="head_css">{{.T "Extra CSS"}} <span class="cms-muted">{{.T "(added to this post's <head>)"}}</span></label>
            <textarea id="head_css" name="head_css" rows="5" class="cms-code">{{.FormPost.HeadCSS}}</textarea>
        </div>
        <div class="cms-field">
            <label for="body_js">{{.T "Extra JavaScript"}} <span class="cms-muted">{{.T "(added before </body>)"}}</span></label>
            <textarea id="body_js" name="body_js" rows="5" class="cms-code">{{.FormPost.BodyJS}}</textarea>
        </div>
    </details>
    {{end}}

    <div class="cms-actions">
        {{if .IsNew}}
        <button type="submit" class="cms-btn cms-btn-primary">{{.T "Create post"}}</button>
        {{else}}
        <button type="submit" name="action" value="save" class="cms-btn cms-btn-ghost">{{.T "Save draft"}}</button>
        <button type="submit" name="action" value="publish" class="cms-btn cms-btn-primary">{{.T "Save & publish"}}</button>
        {{end}}
    </div>
</form>

{{if not .IsNew}}
<p class="cms-hint">{{.T "The post's body is best edited on the site: open"}}
<a href="/{{.FormPost.Slug}}" target="_blank" rel="noopener">/{{.FormPost.Slug}}</a>
{{.T "and press"}} <strong>{{.T "Edit"}}</strong> {{.T "to write in place with sections and snippets."}}</p>
{{end}}

{{if and (not .IsNew) .HasDraftEdits .IsDefaultLocale}}
<form method="post" action="{{.AdminPath}}/posts/{{.FormPost.PostID}}/discard" class="cms-discard"
      data-confirm="{{.T "Discard your unpublished changes and revert to the published version? This can't be undone."}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p class="cms-hint">{{.T "This post has unpublished draft changes."}}</p>
    <button type="submit" class="cms-btn cms-btn-ghost">{{.T "Discard draft changes"}}</button>
</form>
{{end}}

{{if and (not .IsNew) (eq .FormPost.Status "published") .IsDefaultLocale}}
<form method="post" action="{{.AdminPath}}/posts/{{.FormPost.PostID}}/unpublish" class="cms-unpublish"
      data-confirm="{{.T "Take this post off the public site? Nothing is deleted — you can publish it again later."}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <p class="cms-hint">{{.T "This post is live on the site."}}</p>
    <button type="submit" class="cms-btn cms-btn-ghost">{{.T "Unpublish"}}</button>
</form>
{{end}}

{{if and (not .IsNew) .IsDefaultLocale}}
<form method="post" action="{{.AdminPath}}/posts/{{.FormPost.PostID}}/delete" class="cms-danger-zone"
      data-confirm="{{.T "Delete this post and all of its content? This cannot be undone."}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit" class="cms-btn cms-btn-danger">{{.T "Delete post"}}</button>
</form>
{{end}}
{{end}}
