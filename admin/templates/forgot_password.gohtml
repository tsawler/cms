{{define "title"}}{{.T "Forgot your password?"}} — CMS{{end}}

{{define "content"}}
{{if .ResetSent}}
{{/* One confirmation for every address, matching account or not: this
     page must not say which addresses have accounts. */}}
<div class="cms-login-card">
    <h1>{{.T "Check your email"}}</h1>
    <p class="cms-hint">{{.T "If that address has an account, a reset link is on its way. It works once, for the next hour. No email? Check your spam folder, or make sure you typed the address you log in with."}}</p>
    <p><a href="{{.AdminPath}}/login">{{.T "Back to log in"}}</a></p>
</div>
{{else}}
{{if .Captcha}}
{{/* The same Cap wiring as the login page — see the notes there. */}}
<script nonce="{{.Captcha.Nonce}}">
window.CAP_CUSTOM_WASM_URL = {{.Captcha.WasmURL}};
window.CAP_PAKO_URL = {{.Captcha.PakoURL}};
window.CAP_SCRIPT_NONCE = {{.Captcha.Nonce}};
</script>
<script type="module" src="{{.Captcha.ScriptURL}}"></script>
{{if not .Captcha.Visible}}
<script defer src="{{.AdminPath}}/static/login-captcha.js"></script>
{{end}}
{{end}}
<div class="cms-login-card">
    <h1>{{.T "Forgot your password?"}}</h1>
    <p class="cms-hint">{{.T "Enter the email address you log in with and we'll send you a link to set a new one."}}</p>
    {{with .Error}}<div class="cms-alert">{{.}}</div>{{end}}
    <form method="post" action="{{.AdminPath}}/forgot-password" novalidate{{if and .Captcha (not .Captcha.Visible)}} data-cap-endpoint="{{.Captcha.Endpoint}}"{{end}}>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="cms-field">
            <label for="email">{{.T "Email"}}</label>
            <input type="email" id="email" name="email" autocomplete="username" required autofocus>
        </div>
        {{/* Honeypot: hidden from people, filled in by bots. */}}
        <div class="cms-hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>
        {{with .Captcha}}
        {{if .Visible}}
        <div class="cms-field">
            <cap-widget data-cap-api-endpoint="{{.Endpoint}}"></cap-widget>
        </div>
        {{else}}
        <input type="hidden" name="cap-token" value="">
        {{end}}
        {{end}}
        <button type="submit" class="cms-btn cms-btn-primary cms-btn-block">{{.T "Email me a reset link"}}</button>
    </form>
    <p class="cms-hint cms-login-alt"><a href="{{.AdminPath}}/login">{{.T "Back to log in"}}</a></p>
</div>
{{end}}
{{end}}
