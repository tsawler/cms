{{define "title"}}{{if .IsNew}}New user{{else}}Edit user{{end}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{if .IsNew}}New user{{else}}Edit user{{end}}</h1>
    <a class="cms-btn cms-btn-ghost" href="{{.AdminPath}}/users">Back to users</a>
</div>

<form class="cms-form" method="post" novalidate
      action="{{if .IsNew}}{{.AdminPath}}/users/new{{else}}{{.AdminPath}}/users/{{.FormUser.ID}}{{end}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

    <div class="cms-field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" value="{{.FormUser.Name}}" required>
        {{with index .FormErrors "name"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{.FormUser.Email}}" autocomplete="off" required>
        {{with index .FormErrors "email"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="password">{{if .IsNew}}Password{{else}}New password <span class="cms-muted">(leave blank to keep current)</span>{{end}}</label>
        <input type="password" id="password" name="password" autocomplete="new-password" {{if .IsNew}}required{{end}}>
        {{with index .FormErrors "password"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="role">Role</label>
        <select id="role" name="role">
            <option value="editor" {{if eq .FormUser.Role "editor"}}selected{{end}}>Editor — can edit content</option>
            <option value="admin" {{if eq .FormUser.Role "admin"}}selected{{end}}>Admin — can also manage users</option>
        </select>
        {{with index .FormErrors "role"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field cms-field-check">
        <label>
            <input type="checkbox" name="active" {{if .FormUser.Active}}checked{{end}}>
            Active — inactive users cannot log in
        </label>
        {{with index .FormErrors "active"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <button type="submit" class="cms-btn cms-btn-primary">{{if .IsNew}}Create user{{else}}Save changes{{end}}</button>
</form>
{{end}}
