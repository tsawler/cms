{{define "title"}}{{.T "Users"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Users"}}</h1>
    <a class="cms-btn cms-btn-primary" href="{{.AdminPath}}/users/new">{{.T "New user"}}</a>
</div>

{{- /* Status tabs and a name/email search. Tab links keep the search,
       the search form keeps the tab (its hidden status field), and the
       page links below keep both — listPageURL carries the whole query
       string. The handler validates status server-side; these links are
       the only three values it accepts. */}}
<div class="cms-browser-bar cms-list-bar">
    <p class="cms-tabs">
        <a {{if not .UserStatus}}class="cms-active"{{end}}
           href="{{.AdminPath}}/users{{if .UserQuery}}?q={{.UserQuery}}{{end}}">{{.T "Active"}}</a>
        <a {{if eq .UserStatus "inactive"}}class="cms-active"{{end}}
           href="{{.AdminPath}}/users?status=inactive{{if .UserQuery}}&q={{.UserQuery}}{{end}}">{{.T "Inactive"}}</a>
        <a {{if eq .UserStatus "all"}}class="cms-active"{{end}}
           href="{{.AdminPath}}/users?status=all{{if .UserQuery}}&q={{.UserQuery}}{{end}}">{{.T "All"}}</a>
    </p>
    <form method="get" action="{{.AdminPath}}/users" class="cms-browser-search" role="search">
        {{if .UserStatus}}<input type="hidden" name="status" value="{{.UserStatus}}">{{end}}
        <input type="search" name="q" value="{{.UserQuery}}" placeholder="{{.T "Search by name or email…"}}"
               aria-label="{{.T "Search by name or email…"}}">
        {{if .UserQuery}}<a class="cms-btn cms-btn-ghost cms-btn-sm" href="{{.AdminPath}}/users{{if .UserStatus}}?status={{.UserStatus}}{{end}}">{{.T "Clear"}}</a>{{end}}
    </form>
</div>

<table class="cms-table">
    <thead>
    <tr>
        <th>{{.T "Name"}}</th>
        <th>{{.T "Email"}}</th>
        <th>{{.T "Role"}}</th>
        <th>{{.T "Status"}}</th>
        {{- /* The Become column exists only for superadmins — the one
               role the masquerade route lets through. */}}
        {{if .IsSuperadmin}}<th></th>{{end}}
        <th></th>
    </tr>
    </thead>
    <tbody>
    {{range .Users}}
    <tr>
        <td>{{.Name}}</td>
        <td>{{.Email}}</td>
        <td><span class="cms-badge">{{$.T (printf "%s" .Role)}}</span></td>
        <td>{{if .Active}}<span class="cms-badge cms-badge-ok">{{$.T "active"}}</span>{{else}}<span class="cms-badge cms-badge-off">{{$.T "inactive"}}</span>{{end}}</td>
        {{if $.IsSuperadmin}}
        <td class="cms-table-actions">
            {{- /* Become: sign this session in as the user. Never on your
                   own row, and never into an inactive account, which
                   couldn't log in. The route enforces both, and the
                   superadmin gate, server-side. */}}
            {{if and .Active (ne .ID $.User.ID)}}
            <form method="post" action="{{$.AdminPath}}/users/{{.ID}}/masquerade">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <button type="submit" class="cms-btn cms-btn-ghost cms-btn-sm"
                        title="{{$.T "See the admin exactly as this user does. A banner offers the way back."}}">{{$.T "Become"}}</button>
            </form>
            {{end}}
        </td>
        {{end}}
        {{- /* CanManage is canManageUser, decided per row in the handler —
               the same rule the route enforces, rather than a second copy
               of it here. The route refuses either way; this only stops the
               table offering a door that is shut. */}}
        <td class="cms-table-actions">{{if .CanManage}}<a href="{{$.AdminPath}}/users/{{.ID}}">{{$.T "Edit"}}</a>{{end}}</td>
    </tr>
    {{else}}
    <tr><td colspan="{{if .IsSuperadmin}}6{{else}}5{{end}}" class="cms-muted">{{if or .UserQuery .UserStatus}}{{.T "No users match this filter."}}{{else}}{{.T "No users yet."}}{{end}}</td></tr>
    {{end}}
    </tbody>
</table>

{{/* The module's own pagination bar, the same one the posts list and the
     public site's {{cmsPagination}} draw. It renders nothing while the
     users fit on a single page. */}}
{{with .Pager}}{{.HTML}}{{end}}
{{end}}
