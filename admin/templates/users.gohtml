{{define "title"}}{{.T "Users"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Users"}}</h1>
    <a class="cms-btn cms-btn-primary" href="{{.AdminPath}}/users/new">{{.T "New user"}}</a>
</div>

<table class="cms-table">
    <thead>
    <tr>
        <th>{{.T "Name"}}</th>
        <th>{{.T "Email"}}</th>
        <th>{{.T "Role"}}</th>
        <th>{{.T "Status"}}</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {{range .Users}}
    <tr>
        <td>{{.Name}}</td>
        <td>{{.Email}}</td>
        <td><span class="cms-badge">{{$.T (printf "%s" .Role)}}</span></td>
        <td>{{if .Active}}<span class="cms-badge cms-badge-ok">{{$.T "active"}}</span>{{else}}<span class="cms-badge cms-badge-off">{{$.T "inactive"}}</span>{{end}}</td>
        <td class="cms-table-actions"><a href="{{$.AdminPath}}/users/{{.ID}}">{{$.T "Edit"}}</a></td>
    </tr>
    {{else}}
    <tr><td colspan="5" class="cms-muted">{{.T "No users yet."}}</td></tr>
    {{end}}
    </tbody>
</table>
{{end}}
