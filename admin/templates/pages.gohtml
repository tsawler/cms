{{define "title"}}{{.T "Pages"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Pages"}}</h1>
    <a class="cms-btn cms-btn-primary" href="{{.AdminPath}}/pages/new">{{.T "New page"}}</a>
</div>

<table class="cms-table">
    <thead>
    <tr>
        <th>{{.T "Title"}}</th>
        <th>{{.T "Address"}}</th>
        <th>{{.T "Template"}}</th>
        <th>{{.T "Status"}}</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {{range .Pages}}
    <tr>
        <td>{{if .Title}}{{.Title}}{{else}}<span class="cms-muted">{{$.T "(untitled)"}}</span>{{end}}</td>
        <td class="cms-slug">/{{.Slug}}</td>
        <td class="cms-muted">{{$.TemplateLabel .TemplateName}}</td>
        <td>{{if eq .Status "published"}}<span class="cms-badge cms-badge-ok">{{$.T "published"}}</span>{{else}}<span class="cms-badge cms-badge-draft">{{$.T "draft"}}</span>{{end}}{{if eq .Visibility "private"}} <span class="cms-badge">{{$.T "private"}}</span>{{end}}</td>
        <td class="cms-table-actions"><a href="{{$.AdminPath}}/pages/{{.ID}}">{{$.T "Edit"}}</a></td>
    </tr>
    {{else}}
    <tr><td colspan="5" class="cms-muted">{{.T "No pages yet — create your first one."}}</td></tr>
    {{end}}
    </tbody>
</table>
{{end}}
