{{define "layout"}}<!doctype html>
<html lang="{{.AdminLang}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{block "title" .}}CMS{{end}}</title>
    <link rel="stylesheet" href="{{.AdminPath}}/static/admin.css">
    {{- /* The module's pagination styles (render.PagerCSS), so the admin's
           bar and the public site's are one definition rather than two
           that drift. Served as a file, not inlined: the admin's CSP
           allows no inline styles. It states no colors of its own, so it
           picks up the admin's ink from currentColor. */}}
    <link rel="stylesheet" href="{{.AdminPath}}{{.PagerCSSPath}}">
    {{- /* The host's own, last, so its rules win at equal specificity:
           a host that registers admin sections has to be able to style
           the chrome they appear in — a nav count it wants read as a
           badge, say — and the CSP forbids doing that inline. */}}
    {{range .Stylesheets}}<link rel="stylesheet" href="{{.}}">
    {{end -}}
    {{- /* Deliberately not deferred: it reapplies the saved sidebar
           state (a class on <html>) before the body renders, so a
           collapsed menu never flashes open on navigation. */}}
    <script src="{{.AdminPath}}/static/nav-state.js"></script>
    <script src="{{.AdminPath}}/static/admin.js" defer></script>
    {{if .PageScript}}<script src="{{.AdminPath}}/static/{{.PageScript}}" defer></script>{{end}}
</head>
{{- /* Strings admin.js needs but cannot translate itself, since it is a
       static file served to every language. */}}
<body class="cms-admin{{if .User}} cms-has-sidebar{{end}}" data-t-copied="{{.T "Copied!"}}">
{{if .User}}
<aside class="cms-sidebar">
    <div class="cms-sidebar-head">
        <a class="cms-brand" href="{{.AdminPath}}/">CMS</a>
        {{- /* Collapses the sidebar to a rail of icons, for working
               room. admin.js flips the class and keeps the state in
               localStorage; nav-state.js reapplies it on the next page
               before first paint. Without JS the button does nothing and
               the menu simply stays open. */}}
        <button type="button" id="cms-nav-toggle" class="cms-btn cms-btn-ghost cms-nav-toggle"
                data-t-collapse="{{.T "Collapse the menu"}}" data-t-expand="{{.T "Expand the menu"}}"
                aria-expanded="true" aria-label="{{.T "Collapse the menu"}}" title="{{.T "Collapse the menu"}}">
            <span class="cms-nav-toggle-out">{{template "icon-collapse"}}</span><span class="cms-nav-toggle-in">{{template "icon-expand"}}</span>
        </button>
    </div>
    {{- /* The site is built but not yet findable. Stamped on every admin
           page, because the failure this guards against is nobody
           remembering the switch exists. */}}
    {{if .SiteDevelopment}}
    <p class="cms-site-mode"><span class="cms-badge cms-badge-draft"
        title="{{.T "Search engines are asked to skip this site. A superadmin switches it to production in the site settings dialog."}}">{{.T "Development"}}</span></p>
    {{end}}
    {{- /* Louder than the badge above, and for a louder state: while
           this shows, every visitor is being turned away. The one thing
           nobody must be able to leave switched on by accident. */}}
    {{if .SiteLocked}}
    <p class="cms-site-mode"><span class="cms-badge cms-badge-off"
        title="{{.T "The public site is closed — everyone but superadmins is turned away. A superadmin reopens it in the site settings dialog."}}">{{.T "Site closed"}}</span></p>
    {{end}}
    <p class="cms-contents-label">{{.T "Contents"}}</p>
    {{- /* Every entry leads with a glyph — a built-in icon from
           icons.gohtml, a host section's NavIcon, or failing those the
           label's first letter. The expanded menu hides it; the collapsed
           rail shows it alone, with the full label as a tooltip put on
           by admin.js. */}}
    <nav class="cms-nav">
        <a {{if eq .NavCurrent "dashboard"}}class="cms-active" aria-current="page"{{end}} href="{{.AdminPath}}/">
            <span class="cms-nav-glyph" aria-hidden="true">{{template "icon-dashboard"}}</span><span class="cms-nav-label">{{.T "Dashboard"}}</span></a>
        {{- template "navsections" .NavSectionsAt "dashboard"}}
        {{if and .PagesEnabled .IsSuperadmin}}
        <a {{if eq .NavCurrent "pages"}}class="cms-active" aria-current="page"{{end}} href="{{.AdminPath}}/pages">
            <span class="cms-nav-glyph" aria-hidden="true">{{template "icon-pages"}}</span><span class="cms-nav-label">{{.T "Pages"}}</span><span class="cms-nav-leader"></span><span class="cms-nav-count">{{.NavCounts.Pages}}</span></a>
        {{end}}
        {{- template "navsections" .NavSectionsAt "pages"}}
        {{if and .PostsEnabled (or (.Can "blogs") (.Can "news"))}}
        <a {{if eq .NavCurrent "posts"}}class="cms-active" aria-current="page"{{end}} href="{{.AdminPath}}/posts">
            <span class="cms-nav-glyph" aria-hidden="true">{{template "icon-posts"}}</span><span class="cms-nav-label">{{.T "Blog & News"}}</span><span class="cms-nav-leader"></span><span class="cms-nav-count">{{.NavCounts.Posts}}</span></a>
        {{end}}
        {{- template "navsections" .NavSectionsAt "posts"}}
        {{if .MediaEnabled}}
        <a {{if eq .NavCurrent "media"}}class="cms-active" aria-current="page"{{end}} href="{{.AdminPath}}/media">
            <span class="cms-nav-glyph" aria-hidden="true">{{template "icon-media"}}</span><span class="cms-nav-label">{{.T "Media"}}</span><span class="cms-nav-leader"></span><span class="cms-nav-count">{{.NavCounts.Media}}</span></a>
        {{end}}
        {{- template "navsections" .NavSectionsAt "media"}}
        {{if and .PagesEnabled .IsSuperadmin}}
        <a {{if eq .NavCurrent "snippets"}}class="cms-active" aria-current="page"{{end}} href="{{.AdminPath}}/snippets">
            <span class="cms-nav-glyph" aria-hidden="true">{{template "icon-snippets"}}</span><span class="cms-nav-label">{{.T "Snippets"}}</span><span class="cms-nav-leader"></span><span class="cms-nav-count">{{.NavCounts.Snippets}}</span></a>
        {{end}}
        {{- template "navsections" .NavSectionsAt "snippets"}}
        {{if .Can "users"}}
        <a {{if eq .NavCurrent "users"}}class="cms-active" aria-current="page"{{end}} href="{{.AdminPath}}/users">
            <span class="cms-nav-glyph" aria-hidden="true">{{template "icon-users"}}</span><span class="cms-nav-label">{{.T "Users"}}</span><span class="cms-nav-leader"></span><span class="cms-nav-count">{{.NavCounts.Users}}</span></a>
        {{end}}
        {{- template "navsections" .NavSectionsAt "users"}}
        {{- template "navsections" .NavSectionsAt ""}}
        <a href="/"><span class="cms-nav-glyph" aria-hidden="true">{{template "icon-site"}}</span><span class="cms-nav-label">{{.T "Public Site"}}</span></a>
    </nav>
    <div class="cms-sidebar-foot">
        <a class="cms-whoami" href="{{.AdminPath}}/settings" title="{{.T "My account"}}">{{.User.Name}}</a>
        <div class="cms-sidebar-actions">
            {{if .LangToggle}}
            <form method="post" action="{{.AdminPath}}/lang">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <input type="hidden" name="to" value="{{.LangToggle}}">
                <button type="submit" class="cms-btn cms-btn-ghost cms-lang-toggle"
                        title="{{if eq .LangToggle "fr"}}Passer au français{{else}}Switch to English{{end}}">
                    {{if eq .LangToggle "fr"}}FR{{else}}EN{{end}}
                </button>
            </form>
            {{end}}
            <form method="post" action="{{.AdminPath}}/logout">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <button type="submit" class="cms-btn cms-btn-ghost">{{.T "Log out"}}</button>
            </form>
        </div>
    </div>
</aside>
{{end}}
<main class="cms-main{{if .PageWide}} cms-main-wide{{end}}">
    {{if .MasqueradeFrom}}
    {{- /* A superadmin working as someone else. The banner is the only way
           back, so it renders on every page while the masquerade lasts. */}}
    <div class="cms-masquerade" role="status">
        <span>{{.T "You are working as"}} <strong>{{.User.Name}}</strong></span>
        <form method="post" action="{{.AdminPath}}/masquerade/exit">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit" class="cms-btn cms-btn-ghost cms-btn-sm">{{.T "Switch back to"}} {{.MasqueradeFrom.Name}}</button>
        </form>
    </div>
    {{end}}
    {{with .Flash}}<div class="cms-flash">{{.}}</div>{{end}}
    {{template "content" .}}
    {{with .Version}}<footer class="cms-main-foot">CMS {{.}}</footer>{{end}}
</main>
{{if .User}}
{{- /* The collapsed rail's tooltip: one floating element admin.js fills
       with the hovered (or focused) entry's label and parks beside it.
       Fixed-positioned so the sidebar's own scrollbox cannot clip it.
       aria-hidden because it only repeats the link's label, which stays
       in the accessibility tree (visually hidden) while collapsed. */}}
<div class="cms-nav-tip" id="cms-nav-tip" aria-hidden="true"></div>
{{- /* One confirmation dialog for the whole admin, driven by admin.js.
       Its title, detail, button label and tone all come from the form
       being submitted, so a confirmation can never drift from the action
       it is confirming. */}}
<dialog class="cms-dialog cms-confirm" id="cms-confirm" aria-labelledby="cms-confirm-title"
        data-t-ok="{{.T "Continue"}}">
    <div class="cms-confirm-body">
        <h2 id="cms-confirm-title" data-confirm-title></h2>
        <p class="cms-confirm-detail" data-confirm-detail></p>
    </div>
    <div class="cms-dialog-foot">
        <span class="cms-dialog-foot-gap"></span>
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-dialog-close>{{.T "Cancel"}}</button>
        <button type="button" class="cms-btn cms-btn-sm" data-dialog-confirm>{{.T "Continue"}}</button>
    </div>
</dialog>
{{end}}
</body>
</html>{{end}}
{{- /* Host-registered section links for one sidebar position: the layout
       renders this once per NavAfter anchor, so a section's link can sit
       directly under the built-in entry its deployment names. */}}
{{define "navsections"}}{{range .}}
        <a {{if .Active}}class="cms-active" aria-current="page"{{end}}{{with .Confirm}} data-confirm="{{.}}"{{end}} href="{{.URL}}">
            <span class="cms-nav-glyph" aria-hidden="true">{{if .Icon}}{{.Icon}}{{else}}{{printf "%.1s" .Label}}{{end}}</span><span class="cms-nav-label">{{.Label}}</span>{{if .HasCount}}<span class="cms-nav-leader"></span><span class="cms-nav-count">{{.Count}}</span>{{end}}</a>{{end}}{{end}}
