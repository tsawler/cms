{{define "title"}}{{if .IsNew}}{{.T "New user"}}{{else}}{{.T "Edit user"}}{{end}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{if .IsNew}}{{.T "New user"}}{{else}}{{.T "Edit user"}}{{end}}</h1>
    <a class="cms-btn cms-btn-ghost" href="{{.AdminPath}}/users">{{.T "Back to users"}}</a>
</div>

<form class="cms-form" method="post" novalidate
      action="{{if .IsNew}}{{.AdminPath}}/users/new{{else}}{{.AdminPath}}/users/{{.FormUser.ID}}{{end}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

    <div class="cms-field">
        <label for="name">{{.T "Name"}}</label>
        <input type="text" id="name" name="name" value="{{.FormUser.Name}}" required>
        {{with index .FormErrors "name"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="email">{{.T "Email"}}</label>
        <input type="email" id="email" name="email" value="{{.FormUser.Email}}" autocomplete="off" required>
        {{with index .FormErrors "email"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="password">{{if .IsNew}}{{.T "Password"}}{{else}}{{.T "New password"}} <span class="cms-muted">{{.T "(leave blank to keep current)"}}</span>{{end}}</label>
        <input type="password" id="password" name="password" autocomplete="new-password" {{if .IsNew}}required{{end}}>
        {{with index .FormErrors "password"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <div class="cms-field">
        <label for="role">{{.T "Role"}}</label>
        <select id="role" name="role">
            <option value="editor" {{if eq .FormUser.Role "editor"}}selected{{end}}>{{.T "Editor — can edit content"}}</option>
            {{if .IsAdmin}}
            <option value="admin" {{if eq .FormUser.Role "admin"}}selected{{end}}>{{.T "Admin — can also manage users"}}</option>
            <option value="superadmin" {{if eq .FormUser.Role "superadmin"}}selected{{end}}>{{.T "Superadmin — can also edit raw page HTML"}}</option>
            {{end}}
        </select>
        {{with index .FormErrors "role"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    <fieldset class="cms-fieldset cms-perms">
        <legend>{{.T "Permissions"}}</legend>
        {{- /* Grants with PermissionDef.AdminsNeedGrant bind the admin
             role as well, so the hint only claims admins hold everything
             when nothing here says otherwise. */ -}}
        {{$gated := false}}{{range .Permissions}}{{if .AdminsNeedGrant}}{{$gated = true}}{{end}}{{end}}
        <p class="cms-hint">{{.T "What an editor may work on. Admins and superadmins always hold every permission."}}{{if $gated}} {{.T "Exception: some grants here bind admins too and must be ticked for them as well — only superadmins hold everything regardless."}}{{end}}</p>
        <div class="cms-field-check">
            <label><input type="checkbox" name="perm" value="blogs"
                {{if .GrantChecked "blogs"}}checked{{end}} {{if not (.Can "blogs")}}disabled{{end}}>
                {{.T "Blog posts"}}</label>
        </div>
        <div class="cms-field-check">
            <label><input type="checkbox" name="perm" value="news"
                {{if .GrantChecked "news"}}checked{{end}} {{if not (.Can "news")}}disabled{{end}}>
                {{.T "News"}}</label>
        </div>
        <div class="cms-field-check">
            <label><input type="checkbox" name="perm" value="pages"
                {{if .GrantChecked "pages"}}checked{{end}} {{if not (.Can "pages")}}disabled{{end}}>
                {{.T "Pages, menus & site settings"}}</label>
        </div>
        <div class="cms-field-check">
            <label><input type="checkbox" name="perm" value="users"
                {{if .GrantChecked "users"}}checked{{end}} {{if not (.Can "users")}}disabled{{end}}>
                {{.T "User management"}}</label>
        </div>
        {{range .Permissions}}
        <div class="cms-field-check">
            <label><input type="checkbox" name="perm" value="{{.Key}}"
                {{if $.GrantChecked (print .Key)}}checked{{end}} {{if not ($.MayGrant .)}}disabled{{end}}>
                {{.Label}}</label>
        </div>
        {{end}}
        {{with index .FormErrors "perm"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </fieldset>

    <div class="cms-field cms-field-check">
        <label>
            <input type="checkbox" name="active" {{if .FormUser.Active}}checked{{end}}>
            {{.T "Active — inactive users cannot log in"}}
        </label>
        {{with index .FormErrors "active"}}<p class="cms-field-error">{{.}}</p>{{end}}
    </div>

    {{if and (not .IsNew) .FormUser.TwoFactorEnabled}}
    <div class="cms-field cms-field-check">
        <label>
            <input type="checkbox" name="reset_totp">
            {{.T "Reset two-factor authentication — for someone locked out of their authenticator app"}}
        </label>
        <p class="cms-hint">{{.T "They'll log in with just their password until they set it up again."}}</p>
    </div>
    {{end}}

    <button type="submit" class="cms-btn cms-btn-primary">{{if .IsNew}}{{.T "Create user"}}{{else}}{{.T "Save changes"}}{{end}}</button>
</form>

{{- /* Deleting is for admin roles only — an editor with the users
     permission deactivates, never erases — and never one's own account,
     mirroring the handler's guards. */ -}}
{{if and (not .IsNew) .IsAdmin (ne .User.ID .FormUser.ID)}}
<form method="post" action="{{.AdminPath}}/users/{{.FormUser.ID}}/delete" class="cms-danger-zone"
      data-confirm="{{.T "Delete this user? Their posts and uploads remain but lose their author. This cannot be undone."}}">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit" class="cms-btn cms-btn-danger">{{.T "Delete user"}}</button>
</form>
{{end}}
{{end}}
