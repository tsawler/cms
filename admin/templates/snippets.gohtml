{{define "title"}}{{.T "Snippets"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Snippets"}}</h1>
    <a class="cms-btn cms-btn-primary" href="{{.AdminPath}}/snippets/new">{{.T "New snippet"}}</a>
</div>

<p class="cms-muted">{{.T "Snippets are ready-made blocks editors can insert into pages from the editor's palette. Deleting one never changes pages that already use it."}}</p>

<table class="cms-table">
    <thead>
    <tr>
        <th>{{.T "Name"}}</th>
        <th>{{.T "Type"}}</th>
        <th>{{.T "Updated"}}</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {{range .Snippets}}
    <tr>
        <td>{{.Name}}</td>
        <td>{{if .Settings}}{{$.T "Section preset"}}{{else}}{{$.T "Inline block"}}{{end}}</td>
        <td>{{$.D .UpdatedAt}}</td>
        <td class="cms-table-actions cms-actions">
            <a class="cms-btn cms-btn-ghost cms-btn-sm" href="{{$.AdminPath}}/snippets/{{.ID}}">{{$.T "Edit"}}</a>
            <form method="post" action="{{$.AdminPath}}/snippets/{{.ID}}/delete"
                  data-confirm="{{$.T "Delete this snippet? Pages already using it keep their copy."}}">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{$.T "Delete"}}</button>
            </form>
        </td>
    </tr>
    {{else}}
    <tr><td colspan="4" class="cms-muted">{{.T "No custom snippets yet."}}</td></tr>
    {{end}}
    </tbody>
</table>

{{if .ConfigSnippets}}
<h2 class="cms-section-head">{{.T "Built-in snippets"}}</h2>
<p class="cms-muted">{{.T "These come from the site's code and can't be edited here."}}</p>
<table class="cms-table">
    <thead><tr><th>{{.T "Name"}}</th><th>{{.T "Type"}}</th></tr></thead>
    <tbody>
    {{range .ConfigSnippets}}<tr><td>{{.Name}}</td>
        <td>{{if .Settings}}{{$.T "Section preset"}}{{else}}{{$.T "Inline block"}}{{end}}</td></tr>{{end}}
    </tbody>
</table>
{{end}}
{{end}}
