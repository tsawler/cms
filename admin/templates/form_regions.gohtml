{{/* The editable-content fieldset shared by the page and post forms.
     Expects .Regions, .BlockContent, .RegionsTemplate, .Media. */}}
{{define "form_regions"}}
{{if .Regions}}
<input type="hidden" name="regions_template" value="{{.RegionsTemplate}}">
<fieldset class="cms-fieldset">
    <legend>{{.T "Content"}}</legend>
    {{$content := .BlockContent}}
    {{range .Regions}}
    <div class="cms-field">
        <label for="region-{{.Name}}">{{.Name}}</label>
        {{if eq .Kind "sections"}}
        <p class="cms-hint">{{$.T "This area is built from sections — open the page on the site and press"}}
        <strong>{{$.T "Edit"}}</strong> {{$.T "to add, arrange, and edit them directly."}}</p>
        {{else if eq .Kind "text"}}
        <input type="text" id="region-{{.Name}}" name="region-{{.Name}}" value="{{index $content .Name}}">
        {{else if eq .Kind "image"}}
        {{$current := index $content .Name}}
        {{if $current}}<img src="{{$current}}" alt="" class="cms-image-current">{{end}}
        {{if $.MediaEnabled}}
        <select id="region-{{.Name}}" name="region-{{.Name}}">
            <option value="">{{$.T "— no image —"}}</option>
            {{- /* An image the list does not hold — older than the newest
                   listed, or from outside the library — stays chosen.
                   With no option for it the browser would select "no
                   image", and saving the form would clear the region. */}}
            {{$listed := false}}{{range $.Media}}{{if eq .WebURL $current}}{{$listed = true}}{{end}}{{end}}
            {{if and $current (not $listed)}}
            <option value="{{$current}}" selected>{{$.T "(current image)"}}</option>
            {{end}}
            {{range $.Media}}
            <option value="{{.WebURL}}" {{if eq .WebURL $current}}selected{{end}}>{{.Filename}} ({{.Width}}×{{.Height}})</option>
            {{end}}
        </select>
        {{if $.MoreImages}}<p class="cms-hint">{{$.T "Only the newest images are listed here; the in-place editor's image picker can browse them all."}}</p>{{end}}
        <p class="cms-hint">{{$.T "Choose from the"}} <a href="{{$.AdminPath}}/media">{{$.T "media library"}}</a>{{$.T "; upload new images there first."}}</p>
        {{else}}
        <p class="cms-hint">{{$.T "Image uploads are not configured for this site."}}</p>
        <input type="hidden" name="region-{{.Name}}" value="{{$current}}">
        {{end}}
        {{else}}
        <textarea id="region-{{.Name}}" name="region-{{.Name}}" rows="8" class="cms-code">{{index $content .Name}}</textarea>
        {{end}}
    </div>
    {{end}}
</fieldset>
{{end}}
{{end}}
