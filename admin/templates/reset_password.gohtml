{{define "title"}}{{.T "Set a new password"}} — CMS{{end}}

{{define "content"}}
{{if .ResetInvalid}}
{{/* Unknown, expired, and already-used all land here, deliberately
     undifferentiated — see the notes in handlers_reset.go. */}}
<div class="cms-login-card">
    <h1>{{.T "That link doesn't work any more"}}</h1>
    <p class="cms-hint">{{.T "Reset links work once and expire after an hour. Ask for a fresh one and use it right away."}}</p>
    <p><a href="{{.AdminPath}}/forgot-password">{{.T "Send me a new link"}}</a></p>
</div>
{{else}}
<div class="cms-login-card">
    <h1>{{.T "Set a new password"}}</h1>
    {{with .Error}}<div class="cms-alert">{{.}}</div>{{end}}
    <form method="post" action="{{.AdminPath}}/reset-password" novalidate>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="token" value="{{.ResetToken}}">
        <div class="cms-field">
            <label for="password">{{.T "New password"}}</label>
            <input type="password" id="password" name="password" autocomplete="new-password" required autofocus minlength="8">
        </div>
        <div class="cms-field">
            <label for="confirm">{{.T "New password again"}}</label>
            <input type="password" id="confirm" name="confirm" autocomplete="new-password" required minlength="8">
        </div>
        <button type="submit" class="cms-btn cms-btn-primary cms-btn-block">{{.T "Change my password"}}</button>
    </form>
</div>
{{end}}
{{end}}
