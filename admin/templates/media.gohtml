{{define "title"}}{{.T "Media"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Media"}}</h1>
</div>

{{with .Error}}<div class="cms-alert">{{.}}</div>{{end}}

<form class="cms-upload" method="post" action="{{.AdminPath}}/media/upload" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="cms-upload-row">
        <input type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml,.svg,video/mp4,video/webm,.mp4,.webm,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp,.txt,.csv,.zip" required>
        <input type="text" name="alt" placeholder="{{.T "Description (alt text, for images)"}}">
        <select name="folder">
            <option value="">{{.T "No folder"}}</option>
            {{range .Folders}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
        </select>
        <button type="submit" class="cms-btn cms-btn-primary">{{.T "Upload"}}</button>
    </div>
    <p class="cms-hint">{{.T "Images (JPEG, PNG, GIF, WebP — resized automatically), videos (MP4, WebM — stored as uploaded), PDFs, office documents, text/CSV, or ZIP."}}
        {{.T "Images and documents up to 25 MB; videos up to"}} {{.MaxVideoMB}}&nbsp;{{.T "MB."}}
        {{.T "Everything is stored on your site's bucket."}}</p>
</form>

<div class="cms-filter-bar">
    <form method="get" action="{{.AdminPath}}/media" class="cms-filter-form">
        <input type="search" name="q" value="{{.MediaQuery}}" placeholder="{{.T "Search by name…"}}">
        <select name="folder">
            <option value="">{{.T "All folders"}}</option>
            <option value="root" {{if eq .MediaFolder "root"}}selected{{end}}>{{.T "Unfiled"}}</option>
            {{range .Folders}}
            <option value="{{.ID}}" {{if eq $.MediaFolder (printf "%d" .ID)}}selected{{end}}>{{.Name}} ({{.Count}})</option>
            {{end}}
        </select>
        <button type="submit" class="cms-btn cms-btn-ghost">{{.T "Filter"}}</button>
        {{if or .MediaQuery .MediaFolder}}<a class="cms-btn cms-btn-ghost" href="{{.AdminPath}}/media">{{.T "Clear"}}</a>{{end}}
    </form>
    <form method="post" action="{{.AdminPath}}/media/folders/new" class="cms-filter-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="text" name="name" placeholder="{{.T "New folder name"}}" required maxlength="60">
        <button type="submit" class="cms-btn cms-btn-ghost">{{.T "Add folder"}}</button>
    </form>
</div>

<div class="cms-media-grid">
    {{range .Media}}
    <div class="cms-media-card">
        <a href="{{.OriginalURL}}" target="_blank" rel="noopener">
            <img src="{{.ThumbURL}}" alt="{{.Alt}}" loading="lazy">
        </a>
        <div class="cms-media-body">
            <p class="cms-media-name" title="{{.Filename}}">{{.Filename}}</p>
            {{- /* SVGs may have no intrinsic size; skip the 0×0 */}}
            <p class="cms-muted cms-media-dims">{{if .Width}}{{.Width}}×{{.Height}}{{else}}&nbsp;{{end}}</p>
            <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/alt" class="cms-media-alt">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="text" name="alt" value="{{.Alt}}" placeholder="{{$.T "Description (alt text)"}}">
                <button type="submit" class="cms-btn cms-btn-ghost cms-btn-sm">{{$.T "Save"}}</button>
            </form>
            <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/move" class="cms-media-move">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <select name="folder" data-autosubmit title="{{$.T "Folder"}}">
                    <option value="">{{$.T "No folder"}}</option>
                    {{$current := .FolderIDValue}}
                    {{range $.Folders}}<option value="{{.ID}}" {{if eq .ID $current}}selected{{end}}>{{.Name}}</option>{{end}}
                </select>
            </form>
            <div class="cms-media-actions">
                <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-copy="{{.WebURL}}">{{$.T "Copy link"}}</button>
                <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/delete"
                      data-confirm="{{$.T "Delete this image? Pages still using it will show a broken picture."}}">
                    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                    <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{$.T "Delete"}}</button>
                </form>
            </div>
        </div>
    </div>
    {{else}}
    <p class="cms-muted">{{.T "No images yet — upload your first one above."}}</p>
    {{end}}
</div>

{{if .Videos}}
<h2 class="cms-section-head">{{.T "Videos"}}</h2>
<div class="cms-media-grid">
    {{range .Videos}}
    <div class="cms-media-card">
        <a href="{{.OriginalURL}}" target="_blank" rel="noopener">
            {{if .ThumbURL}}
            <img src="{{.ThumbURL}}" alt="" loading="lazy">
            {{else}}
            <video src="{{.OriginalURL}}" preload="metadata" muted></video>
            {{end}}
        </a>
        <div class="cms-media-body">
            <p class="cms-media-name" title="{{.Filename}}">{{.Filename}}</p>
            <p class="cms-muted cms-media-dims">{{if .Width}}{{.Width}}×{{.Height}} · {{end}}{{.SizeHuman}}</p>
            <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/move" class="cms-media-move">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <select name="folder" data-autosubmit title="{{$.T "Folder"}}">
                    <option value="">{{$.T "No folder"}}</option>
                    {{$current := .FolderIDValue}}
                    {{range $.Folders}}<option value="{{.ID}}" {{if eq .ID $current}}selected{{end}}>{{.Name}}</option>{{end}}
                </select>
            </form>
            <div class="cms-media-actions">
                <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-copy="{{.OriginalURL}}">{{$.T "Copy link"}}</button>
                <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/delete"
                      data-confirm="{{$.T "Delete this video? Pages still using it will show a broken player."}}">
                    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                    <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{$.T "Delete"}}</button>
                </form>
            </div>
        </div>
    </div>
    {{end}}
</div>
{{end}}

<h2 class="cms-section-head">{{.T "Documents"}}</h2>
<table class="cms-table">
    <thead>
    <tr>
        <th>{{.T "Name"}}</th>
        <th>{{.T "Type"}}</th>
        <th>{{.T "Size"}}</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {{range .Documents}}
    <tr>
        <td><a href="{{.OriginalURL}}" target="_blank" rel="noopener">{{.Filename}}</a></td>
        <td><span class="cms-badge">{{.Ext}}</span></td>
        <td>{{.SizeHuman}}</td>
        <td class="cms-table-actions cms-actions">
            <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/move">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <select name="folder" data-autosubmit title="{{$.T "Folder"}}">
                    <option value="">{{$.T "No folder"}}</option>
                    {{$current := .FolderIDValue}}
                    {{range $.Folders}}<option value="{{.ID}}" {{if eq .ID $current}}selected{{end}}>{{.Name}}</option>{{end}}
                </select>
            </form>
            <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-copy="{{.OriginalURL}}">{{$.T "Copy link"}}</button>
            <form method="post" action="{{$.AdminPath}}/media/{{.ID}}/delete"
                  data-confirm="{{$.T "Delete this document? Pages that link to it will have a broken link."}}">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{$.T "Delete"}}</button>
            </form>
        </td>
    </tr>
    {{else}}
    <tr><td colspan="4" class="cms-muted">{{.T "No documents yet."}}</td></tr>
    {{end}}
    </tbody>
</table>

{{if .Folders}}
<h2 class="cms-section-head">{{.T "Folders"}}</h2>
<table class="cms-table">
    <thead><tr><th>{{.T "Name"}}</th><th>{{.T "Files"}}</th><th></th></tr></thead>
    <tbody>
    {{range .Folders}}
    <tr>
        <td>{{.Name}}</td>
        <td>{{.Count}}</td>
        <td class="cms-table-actions">
            <form method="post" action="{{$.AdminPath}}/media/folders/{{.ID}}/delete"
                  data-confirm="{{$.T "Delete this folder? Its files will be kept and become unfiled."}}">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{$.T "Delete"}}</button>
            </form>
        </td>
    </tr>
    {{end}}
    </tbody>
</table>
{{end}}
{{end}}
