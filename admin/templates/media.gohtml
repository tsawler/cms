{{define "title"}}{{.T "Media"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Media"}}</h1>
</div>

{{with .Error}}<div class="cms-alert">{{.}}</div>{{end}}

{{- /* Kind tabs and a search that spans every folder. Tab links keep a
       search but never the folder — folders belong to one kind, so another
       tab opens at its own root. */}}
<div class="cms-browser-bar">
    <p class="cms-tabs">
        <a {{if eq .MediaTab "images"}}class="cms-active"{{end}}
           href="{{.AdminPath}}/media?tab=images{{if .MediaQuery}}&q={{.MediaQuery}}{{end}}">{{.T "Images"}} <span class="cms-tab-count">{{len .Media}}</span></a>
        <a {{if eq .MediaTab "documents"}}class="cms-active"{{end}}
           href="{{.AdminPath}}/media?tab=documents{{if .MediaQuery}}&q={{.MediaQuery}}{{end}}">{{.T "Documents"}} <span class="cms-tab-count">{{len .Documents}}</span></a>
        <a {{if eq .MediaTab "videos"}}class="cms-active"{{end}}
           href="{{.AdminPath}}/media?tab=videos{{if .MediaQuery}}&q={{.MediaQuery}}{{end}}">{{.T "Videos"}} <span class="cms-tab-count">{{len .Videos}}</span></a>
    </p>
    <form method="get" action="{{.AdminPath}}/media" class="cms-browser-search" role="search">
        <input type="hidden" name="tab" value="{{.MediaTab}}">
        <input type="search" name="q" value="{{.MediaQuery}}" placeholder="{{.T "Search all folders by name…"}}"
               aria-label="{{.T "Search all folders by name…"}}">
        {{if .MediaQuery}}<a class="cms-btn cms-btn-ghost cms-btn-sm" href="{{.AdminPath}}/media?tab={{.MediaTab}}">{{.T "Clear"}}</a>{{end}}
    </form>
</div>

{{- /* Path bar: where you are on the left, what you can do on the right. */}}
<div class="cms-browser-bar cms-browser-path">
    <nav class="cms-crumbs" aria-label="{{.T "Location"}}">
        {{if .MediaQuery}}
        <a href="{{.AdminPath}}/media?tab={{.MediaTab}}">{{.T "All media"}}</a>
        <span class="cms-crumb-sep" aria-hidden="true">/</span>
        <strong>{{.T "Search results"}}</strong>
        {{else if .CurrentFolder}}
        <a href="{{.AdminPath}}/media?tab={{.MediaTab}}">{{.T "All media"}}</a>
        <span class="cms-crumb-sep" aria-hidden="true">/</span>
        <svg class="cms-folder-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
        <strong>{{.CurrentFolder.Name}}</strong>
        <span class="cms-muted cms-crumb-count">{{.CurrentFolder.Count}}</span>
        <form method="post" action="{{.AdminPath}}/media/folders/{{.CurrentFolder.ID}}/delete" class="cms-crumb-delete"
              data-confirm="{{.T "Delete this folder? Its files will be kept and become unfiled."}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="tab" value="{{.MediaTab}}">
            <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{.T "Delete folder"}}</button>
        </form>
        {{else}}
        <strong>{{.T "All media"}}</strong>
        {{end}}
    </nav>
    <div class="cms-browser-tools">
        <div class="cms-view-toggle" data-view-toggle>
            <button type="button" data-view="grid" title="{{.T "Icon view"}}" aria-label="{{.T "Icon view"}}">▦</button>
            <button type="button" data-view="list" title="{{.T "List view"}}" aria-label="{{.T "List view"}}">≡</button>
        </div>
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm cms-btn-icon" data-inspector-toggle
                title="{{.T "Details"}}" aria-label="{{.T "Details"}}" aria-pressed="false">ⓘ</button>
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-dialog-open="cms-newfolder">{{.T "New folder"}}</button>
        <button type="button" class="cms-btn cms-btn-primary cms-btn-sm" data-dialog-open="cms-uploader">{{.T "Upload"}}</button>
    </div>
</div>

{{- /* The dialogs below need JavaScript to open, so the plain forms they
       replace stay available when it is off. */}}
<noscript>
    <form class="cms-upload" method="post" action="{{.AdminPath}}/media/upload" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="cms-upload-row">
            <input type="file" name="file" accept="{{template "media_accept"}}" required>
            <select name="folder" aria-label="{{.T "Destination"}}">
                <option value="">{{.T "No folder"}}</option>
                {{range .Folders}}<option value="{{.ID}}" {{if and $.CurrentFolder (eq $.CurrentFolder.ID .ID)}}selected{{end}}>{{.Name}}</option>{{end}}
            </select>
            <button type="submit" class="cms-btn cms-btn-primary">{{.T "Upload"}}</button>
        </div>
    </form>
    <form class="cms-upload" method="post" action="{{.AdminPath}}/media/folders/new">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="tab" value="{{.MediaTab}}">
        <div class="cms-upload-row">
            <input type="text" name="name" placeholder="{{.T "New folder name"}}" required maxlength="60">
            <button type="submit" class="cms-btn cms-btn-ghost">{{.T "New folder"}}</button>
        </div>
    </form>
</noscript>

{{- /* One listing for all three tabs. Folders are entries in it, like
       Finder shows them, and appear at the root of a browse (never during
       a search, which spans every folder and lists results flat).

       Both views render the same nodes — the icon view is a grid of tiles,
       the list view reflows those same cells into columns. One DOM keeps
       the selection model, the keyboard handling and the inspector from
       having to exist twice. */}}
{{$showFolders := and (not .CurrentFolder) (not .MediaQuery) (gt (len .Folders) 0)}}

<div class="cms-browser">
    {{- /* Selection actions. Hidden until something is selected: the
           per-item buttons this replaced were on screen at all times, four
           to a tile, which is what made the old grid unreadable. */}}
    <div class="cms-selbar" data-selbar hidden>
        <span class="cms-selbar-count" data-sel-count aria-live="polite"
              data-t-one="{{.T "1 selected"}}" data-t-many="{{.T "{n} selected"}}"></span>
        <form method="post" action="{{.AdminPath}}/media/bulk/move" class="cms-selbar-move" data-sel-form>
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <select name="folder" data-sel-move aria-label="{{.T "Move to"}}">
                <option value="">{{.T "Move to…"}}</option>
                <option value="root">{{.T "No folder"}}</option>
                {{range .Folders}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
            </select>
        </form>
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-sel-copy>{{.T "Copy link"}}</button>
        <form method="post" action="{{.AdminPath}}/media/bulk/delete" data-sel-form
              data-confirm="{{.T "Delete the selected files? Pages still using them will break."}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit" class="cms-btn cms-btn-danger cms-btn-sm">{{.T "Delete"}}</button>
        </form>
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm cms-selbar-clear" data-sel-clear>{{.T "Clear"}}</button>
    </div>

    <div class="cms-browser-body">
        <div class="cms-items-wrap">
            {{- /* Column headings, list view only. Clicking one sorts. */}}
            <div class="cms-items-head">
                <span class="cms-col-thumb"></span>
                <button type="button" class="cms-col-name" data-sort="name">{{.T "Name"}}</button>
                <button type="button" class="cms-col-kind" data-sort="kind">{{.T "Type"}}</button>
                <button type="button" class="cms-col-size" data-sort="size">{{.T "Size"}}</button>
                <button type="button" class="cms-col-dims" data-sort="dims">{{.T "Dimensions"}}</button>
                <button type="button" class="cms-col-added" data-sort="added">{{.T "Added"}}</button>
            </div>

            <ul class="cms-items" data-items role="listbox" aria-multiselectable="true"
                aria-label="{{.T "Media"}}" tabindex="0">
                {{if $showFolders}}
                {{range .Folders}}
                <li class="cms-item cms-item-folder" role="option" aria-selected="false"
                    data-open="{{$.AdminPath}}/media?tab={{$.MediaTab}}&folder={{.ID}}"
                    data-folder-id="{{.ID}}"
                    data-name="{{.Name}}">
                    <span class="cms-item-thumb">
                        <svg class="cms-folder-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
                    </span>
                    <span class="cms-item-name" title="{{.Name}}">{{.Name}}</span>
                    <span class="cms-item-kind"><span class="cms-badge">{{$.T "folder"}}</span></span>
                    <span class="cms-item-size">{{if eq .Count 1}}1 {{$.T "file"}}{{else}}{{.Count}} {{$.T "files"}}{{end}}</span>
                    <span class="cms-item-dims"></span>
                    <span class="cms-item-added"></span>
                </li>
                {{end}}
                {{end}}

                {{range .Entries}}
                <li class="cms-item" role="option" aria-selected="false"
                    data-id="{{.ID}}"
                    data-open="{{.OriginalURL}}"
                    {{- /* Not data-copy: that attribute marks a
                           copy-to-clipboard button, and the shared handler
                           would treat a click anywhere on this entry as
                           one and overwrite it with "Copied!". */}}
                    {{- /* Absolute: this is the value Copy link puts on
                           the clipboard, and it has to work when pasted
                           outside the site. */}}
                    data-url="{{$.Abs .WebURL}}"
                    data-name="{{.Filename}}"
                    data-kind="{{.Kind}}"
                    data-ext="{{if .Ext}}{{slice .Ext 1}}{{end}}"
                    data-size="{{.Size}}"
                    data-size-human="{{.SizeHuman}}"
                    data-dims="{{if .Width}}{{.Width}}×{{.Height}}{{end}}"
                    data-added="{{.CreatedAt.Unix}}"
                    data-added-human="{{.CreatedAt.Format "Jan 2, 2006"}}"
                    data-alt="{{.Alt}}"
                    data-thumb="{{.ThumbURL}}">
                    <span class="cms-item-thumb">
                        {{if .ThumbURL}}
                        <img src="{{.ThumbURL}}" alt="" loading="lazy">
                        {{else if eq .Kind "video"}}
                        <span class="cms-item-sheet cms-item-sheet-video" aria-hidden="true">
                            <span class="cms-item-ext">{{if .Ext}}{{slice .Ext 1}}{{end}}</span>
                        </span>
                        {{else}}
                        {{- /* No thumbnail to show, so the file states what it
                               is: the extension set like a stamp on a sheet. */}}
                        <span class="cms-item-sheet" aria-hidden="true">
                            <span class="cms-item-ext">{{if .Ext}}{{slice .Ext 1}}{{end}}</span>
                        </span>
                        {{end}}
                    </span>
                    <span class="cms-item-name" title="{{.Filename}}">{{.Filename}}
                        {{- if and (eq .Kind "image") (not .Alt)}}
                        {{- /* An image nobody has described. A stamp shows it
                               at a glance; the old alt field on every tile
                               showed only that a field existed. */}}
                        <span class="cms-badge cms-badge-draft cms-badge-noalt">{{$.T "no alt"}}</span>
                        {{- end}}
                    </span>
                    <span class="cms-item-kind"><span class="cms-badge">{{if .Ext}}{{slice .Ext 1}}{{end}}</span></span>
                    <span class="cms-item-size">{{.SizeHuman}}</span>
                    <span class="cms-item-dims">{{if .Width}}{{.Width}}×{{.Height}}{{end}}</span>
                    <span class="cms-item-added">{{.CreatedAt.Format "Jan 2, 2006"}}</span>
                </li>
                {{end}}
            </ul>

            {{if and (not .Entries) (not $showFolders)}}
            <p class="cms-empty">
                {{if .MediaQuery}}{{.T "Nothing matches that search."}}
                {{else if eq .MediaTab "documents"}}{{.T "No documents here yet. Drop files on this page, or use Upload."}}
                {{else if eq .MediaTab "videos"}}{{.T "No videos here yet. Drop an MP4 or WebM on this page, or use Upload."}}
                {{else}}{{.T "No images here yet. Drop files on this page, or use Upload."}}{{end}}
            </p>
            {{end}}
        </div>

        {{- /* Inspector: everything about one file, which is where alt text
               and Copy link went when they left the tiles. */}}
        <aside class="cms-inspector" data-inspector hidden aria-label="{{.T "Details"}}"
               data-t-none="{{.T "Select one file to see its details."}}">
            <div class="cms-inspector-preview" data-inspector-preview></div>
            <p class="cms-inspector-name" data-inspector-name></p>
            <dl class="cms-inspector-facts" data-inspector-facts
                data-t-kind="{{.T "Type"}}" data-t-size="{{.T "Size"}}"
                data-t-dims="{{.T "Dimensions"}}" data-t-added="{{.T "Added"}}"></dl>
            <form method="post" class="cms-inspector-alt" data-inspector-alt
                  data-action-template="{{.AdminPath}}/media/{id}/alt">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <label for="cms-inspector-alt-input">{{.T "Description (alt text)"}}</label>
                <input id="cms-inspector-alt-input" type="text" name="alt" autocomplete="off">
                <button type="submit" class="cms-btn cms-btn-ghost cms-btn-sm">{{.T "Save"}}</button>
                <p class="cms-hint">{{.T "Screen readers read this instead of the picture."}}</p>
            </form>
            <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm cms-btn-block" data-inspector-copy>{{.T "Copy link"}}</button>
        </aside>
    </div>
</div>

{{- /* Upload: one dialog with two faces. It opens on the drop zone and
       swaps to the transfer queue once files are chosen, so picking and
       watching are the same place rather than two. */}}
<dialog class="cms-dialog cms-uploader" id="cms-uploader"
        data-upload-url="{{.AdminPath}}/api/media"
        data-csrf="{{.CSRFToken}}"
        data-t-title="{{.T "Upload"}}"
        data-t-progress="{{.T "Uploading — {done} of {total}"}}"
        data-t-complete="{{.T "Upload complete"}}"
        data-t-partial="{{.T "Finished — {failed} could not be uploaded"}}"
        data-t-queued="{{.T "Queued"}}"
        data-t-done="{{.T "Done"}}"
        data-t-canceled="{{.T "Canceled"}}"
        data-t-failed="{{.T "Upload failed."}}"
        data-t-failedstate="{{.T "Failed"}}"
        data-t-cancel="{{.T "Cancel"}}"
        data-t-unfiled="{{.T "saved outside the folder"}}"
        aria-labelledby="cms-uploader-title">
    <div class="cms-dialog-head">
        <h2 id="cms-uploader-title" data-upload-title>{{.T "Upload"}}</h2>
        <button type="button" class="cms-dialog-x" data-dialog-close aria-label="{{.T "Close"}}">✕</button>
    </div>

    <div class="cms-dialog-body">
        <div data-upload-pick>
            <label class="cms-dropzone" data-dropzone>
                <input type="file" multiple accept="{{template "media_accept"}}" data-upload-input>
                <span class="cms-dropzone-text">{{.T "Drop files here, or choose files"}}</span>
            </label>
            <div class="cms-dialog-field">
                <label for="cms-upload-folder">{{.T "Destination"}}</label>
                <select id="cms-upload-folder" data-upload-folder>
                    <option value="">{{.T "No folder"}}</option>
                    {{range .Folders}}<option value="{{.ID}}" {{if and $.CurrentFolder (eq $.CurrentFolder.ID .ID)}}selected{{end}}>{{.Name}}</option>{{end}}
                </select>
            </div>
            <p class="cms-hint">{{.T "Images (JPEG, PNG, GIF, WebP — resized automatically; SVG), videos (MP4, WebM — stored as uploaded), PDFs, office documents, text/CSV, or ZIP."}}
                {{.T "Images and documents up to 25 MB; videos up to"}} {{.MaxVideoMB}}&nbsp;{{.T "MB."}}</p>
        </div>

        <ul class="cms-upload-queue" data-upload-queue hidden></ul>
    </div>

    <div class="cms-dialog-foot">
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-upload-more hidden>{{.T "Add more files"}}</button>
        <span class="cms-dialog-foot-gap"></span>
        <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-upload-stop hidden>{{.T "Stop"}}</button>
        <button type="button" class="cms-btn cms-btn-primary cms-btn-sm" data-dialog-close>{{.T "Done"}}</button>
    </div>
</dialog>

<dialog class="cms-dialog cms-dialog-sm" id="cms-newfolder">
    <form method="post" action="{{.AdminPath}}/media/folders/new">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="tab" value="{{.MediaTab}}">
        <div class="cms-dialog-head">
            <h2>{{.T "New folder"}}</h2>
            <button type="button" class="cms-dialog-x" data-dialog-close aria-label="{{.T "Close"}}">✕</button>
        </div>
        <div class="cms-dialog-body">
            <div class="cms-dialog-field">
                <label for="cms-newfolder-name">{{.T "Name"}}</label>
                <input id="cms-newfolder-name" type="text" name="name" required maxlength="60" autocomplete="off">
            </div>
        </div>
        <div class="cms-dialog-foot">
            <span class="cms-dialog-foot-gap"></span>
            <button type="button" class="cms-btn cms-btn-ghost cms-btn-sm" data-dialog-close>{{.T "Cancel"}}</button>
            <button type="submit" class="cms-btn cms-btn-primary cms-btn-sm">{{.T "Create folder"}}</button>
        </div>
    </form>
</dialog>
{{end}}

{{- /* The upload accept list, in one place so the dialog and the no-JS
       fallback can never drift apart. */}}
{{define "media_accept"}}image/jpeg,image/png,image/gif,image/webp,image/svg+xml,.svg,video/mp4,video/webm,.mp4,.webm,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp,.txt,.csv,.zip{{end}}

{{- /* One folder entry per folder, shaped like a media card so the grid
       and list views style it exactly like the files it sits among. */}}
{{define "media_folder_cards"}}
{{range .Folders}}
<a class="cms-media-card cms-folder-card" href="{{$.AdminPath}}/media?tab={{$.MediaTab}}&folder={{.ID}}">
    <span class="cms-folder-thumb">
        <svg class="cms-folder-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
    </span>
    <div class="cms-media-body">
        <p class="cms-media-name" title="{{.Name}}">{{.Name}}</p>
        <p class="cms-muted cms-media-dims">{{if eq .Count 1}}1 {{$.T "file"}}{{else}}{{.Count}} {{$.T "files"}}{{end}}</p>
    </div>
</a>
{{end}}
{{end}}
