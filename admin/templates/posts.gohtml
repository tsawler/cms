{{define "title"}}{{.T "Blog & News"}} — CMS{{end}}

{{define "content"}}
<div class="cms-page-head">
    <h1>{{.T "Blog & News"}}</h1>
    <a class="cms-btn cms-btn-primary" href="{{.AdminPath}}/posts/new">{{.T "New post"}}</a>
</div>

<p class="cms-tabs">
    {{if and (.Can "blogs") (.Can "news")}}
    <a {{if not .FeedFilter}}class="cms-active"{{end}} href="{{.AdminPath}}/posts">{{.T "All"}}</a>
    {{end}}
    {{if .Can "blogs"}}
    <a {{if eq .FeedFilter "blog"}}class="cms-active"{{end}} href="{{.AdminPath}}/posts?feed=blog">{{.T "Blog"}}</a>
    {{end}}
    {{if .Can "news"}}
    <a {{if eq .FeedFilter "news"}}class="cms-active"{{end}} href="{{.AdminPath}}/posts?feed=news">{{.T "News"}}</a>
    {{end}}
</p>

<table class="cms-table">
    <thead>
    <tr>
        <th>{{.T "Title"}}</th>
        <th>{{.T "Feed"}}</th>
        <th>{{.T "Date"}}</th>
        <th>{{.T "Author"}}</th>
        <th>{{.T "Status"}}</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {{range .Posts}}
    <tr>
        <td>{{if .Title}}{{.Title}}{{else}}<span class="cms-muted">{{$.T "(untitled)"}}</span>{{end}}</td>
        <td>{{$.T (printf "%s" .Feed)}}</td>
        <td>{{$.D .PublishedAt}}</td>
        <td>{{if .AuthorName}}{{.AuthorName}}{{else}}<span class="cms-muted">—</span>{{end}}</td>
        <td>{{if eq .Status "published"}}<span class="cms-badge cms-badge-ok">{{$.T "published"}}</span>{{else}}<span class="cms-badge cms-badge-draft">{{$.T "draft"}}</span>{{end}}</td>
        <td class="cms-table-actions"><a href="{{$.AdminPath}}/posts/{{.PostID}}">{{$.T "Edit"}}</a></td>
    </tr>
    {{else}}
    <tr><td colspan="6" class="cms-muted">{{.T "No posts yet — write your first one."}}</td></tr>
    {{end}}
    </tbody>
</table>

{{/* The module's own pagination bar (render.Pager.HTML), the same one
     {{cmsPagination}} draws on the public site. It renders nothing while
     the posts fit on a single page. */}}
{{with .Pager}}{{.HTML}}{{end}}
{{end}}
